///
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
generator client {
  provider = "prisma-client-js"
}
//
datasource db {
  // example sqlite for dev
  //provider = "sqlite"
  //url      = "file:./dev.db"
  //
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //
}
// 
// A piece of content. `type` distinguishes the kinds — "page", "post", and
// whatever else a site needs — so posts and pages share one table, one slug
// space and one renderer (NC-41).
model Page {
  id                Int @id @default(autoincrement())
  title             String
  seoTitle          String?
  description       String
  seoDescription    String?
  slug              String @unique
  type              String
  jsonld            String?
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?

  categoryId        Int?
  category          Category? @relation(fields: [categoryId], references: [id])
  // Replaces the old freeform `tags String?` column: tags are entities now, so
  // they can be listed and filtered on (NC-41). Breaking change for an existing
  // database — see the release notes.
  tags              Tag[]
  visits            Visit[]

  @@index([title], map: "title")
  @@index([type], map: "page_type")
  @@index([categoryId], map: "page_category")

}
//
model Category {
  id                Int @id @default(autoincrement())
  name              String
  slug              String @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?

  pages             Page[]
}
//
model Tag {
  id                Int @id @default(autoincrement())
  name              String
  slug              String @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?

  pages             Page[]
}
//
// One block of a page's layout. `parent` is the id of the page it belongs to
// and `position` its order within that page (NC-42): without an explicit order
// the layout came back in whatever order the database felt like.
model Component {
  id                Int @id @default(autoincrement())
  name              String
  property          String
  parent            Int
  position          Int @default(0)
  template          String
  data              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?

  @@index([parent, position], map: "component_parent_position")
}
//
model Entity {
  id                Int @id @default(autoincrement())
  name              String
  attribute         String
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?
}
model User {
  id                Int @id @default(autoincrement())
  username          String @unique
  email             String @unique
  password          String  //@hasher(argon2i)
  firstName         String
  lastName          String
  isAdmin           Boolean
  isStaff           Boolean
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?

  passwordResets    PasswordResetToken[]
}
//
// Password reset tokens (NC-39).
//
// Only the SHA-256 hash of the token is stored: a database dump must not let
// anyone take over an account, the same reason passwords are hashed. The
// plaintext exists only in the link sent to the user.
model PasswordResetToken {
  id                Int @id @default(autoincrement())
  tokenHash         String @unique
  userId            Int
  user              User @relation(fields: [userId], references: [id])
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([userId], map: "password_reset_user")
}
model Role {
  id                Int @id @default(autoincrement())
  name              String
  updatedAt         DateTime @default(now())
  deletedAt         DateTime?
}
//
// A visit to a page. The relation uses a dedicated foreign key (`pageId`): the
// previous version reused Visit's own primary key as the FK to Page and never
// declared the opposite field, so `prisma generate` failed with P1012 (NC-24).
model Visit {
  id                Int @id @default(autoincrement())
  pageId            Int
  page              Page @relation(fields: [pageId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([pageId], map: "visit_page")
}

