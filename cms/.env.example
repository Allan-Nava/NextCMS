# Copy to .env and fill in. Never commit a real value here (NC-5): this file
# used to carry a live Heroku Postgres connection string, which is still in the
# git history and must be rotated on the provider.

# --- database -----------------------------------------------------------
# Prisma connection string. See https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- authentication -----------------------------------------------------
# Mandatory. The app refuses to sign or verify a token without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""
# Lifetime of the access and refresh tokens (zeit/ms format).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Self-registration through POST /api/auth/register. Off by default: with it
# off, accounts are created by an admin through POST /api/user.
ALLOW_PUBLIC_REGISTRATION="false"
# Lifetime of a password reset link, in minutes.
PASSWORD_RESET_TTL_MINUTES="30"

# --- runtime ------------------------------------------------------------
# debug | info | warn | error (defaults to info in production)
LOG_LEVEL="info"
# Public URLs, exposed to the browser through next.config.js.
BASE_URI="http://localhost:3000"
API_URI="http://localhost:3000/api"
ADMIN_URL="http://localhost:4000"
